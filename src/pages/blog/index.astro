---
import MainLayout from '../../layouts/MainLayout.astro';
import { getPostsByLocale } from '../../lib/blog';
import SiteHeader from '../../components/SiteHeader.astro';

const posts = await getPostsByLocale('en');
---

<MainLayout title="blog | derivadas.dev">
	<SiteHeader locale="en" activeTab="blog" />

	<section class="panel">
        <h2 class="panel-title">~/blog</h2>
		{posts.length === 0 ? (
			<p>I'll be posting about upcoming projects (and any other stuff I find interesting) soon. <em>Stay tuned!</em></p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li class="post-item">
						<a href={`/blog/${post.data.urlSlug}/`}>{post.data.title}</a>
						<span class="muted"> - {post.data.pubDate.toLocaleDateString()}</span>
					</li>
				))}
			</ul>
		)}
	</section>
</MainLayout>